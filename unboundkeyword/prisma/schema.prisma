generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          String    @default("USER")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]
  lists    KeywordList[]
  discoverySessions DiscoverySession[]
  discoveryKeywords DiscoveryKeyword[]
  keywordSnapshots KeywordSnapshot[]
  keywordDemographics KeywordDemographic[]
  sites SiteProject[]
  preferences UserPreference?
  decisionRuns DecisionRun[]
  dailyIntelDigests DailyIntelDigest[]
  keywordIntelligence KeywordIntelligence[]
}

model SiteProject {
  id          String   @id @default(cuid())
  userId      String
  domain      String
  label       String?
  location    String   @default("United States")
  language    String   @default("en")
  ga4Connected  Boolean @default(false)
  gscConnected  Boolean @default(false)
  // Up to 5 competitor domains stored as JSON array string
  competitors String   @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  lists KeywordList[]
  discoverySessions DiscoverySession[]
  discoveryKeywords DiscoveryKeyword[]
  selectedByPreferences UserPreference[] @relation("SelectedSite")
  decisionRuns DecisionRun[]
  dailyIntelDigests DailyIntelDigest[]

  @@index([userId, updatedAt])
  @@unique([userId, domain])
}

model UserPreference {
  id             String   @id @default(cuid())
  userId         String   @unique
  selectedSiteId String?
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  selectedSite SiteProject? @relation("SelectedSite", fields: [selectedSiteId], references: [id], onDelete: SetNull)
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Core: Keyword Lists ──────────────────────────────────────────────────────

model KeywordList {
  id          String   @id @default(cuid())
  userId      String
  siteId      String?
  name        String
  description String?
  color       String   @default("#6366f1") // tailwind indigo-500
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  site     SiteProject?    @relation(fields: [siteId], references: [id], onDelete: SetNull)
  keywords KeywordInList[]

  @@index([userId, siteId, updatedAt])
}

model KeywordInList {
  id         String   @id @default(cuid())
  listId     String
  keyword    String
  volume     Int?
  difficulty Int?
  cpc        Float?
  intent     String? // informational|transactional|navigational|commercial
  competition Float?
  source     String   @default("manual") // manual|discover|magic|gap|llm|competitor|import
  notes      String?
  addedAt    DateTime @default(now())

  list KeywordList @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@unique([listId, keyword])
}

// ─── Discovery Sessions (AnswerThePublic-style) ───────────────────────────────

model DiscoverySession {
  id           String   @id @default(cuid())
  userId       String
  siteId       String?
  seedKeyword  String
  location     String   @default("United States")
  language     String   @default("en")
  resultsJson  String   // JSON: DiscoveryResult[]
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  site SiteProject? @relation(fields: [siteId], references: [id], onDelete: SetNull)
  keywords DiscoveryKeyword[]

  @@index([userId])
  @@index([userId, siteId, createdAt])
}

model DiscoveryKeyword {
  id              String   @id @default(cuid())
  sessionId       String?
  userId          String
  siteId          String?
  seedKeyword     String
  keyword         String
  groupType       String
  letter          String?
  platform        String   @default("google")
  location        String
  language        String
  volume          Int?
  desktopVolume   Int?     // Desktop-specific volume
  mobileVolume    Int?     // Mobile-specific volume
  difficulty      Int?
  cpc             Float?
  intent          String?
  ageRangeData    String?  // JSON: { "18-24": 15, "25-34": 25, ...}
  source          String   @default("discover")
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  site SiteProject? @relation(fields: [siteId], references: [id], onDelete: SetNull)
  session DiscoverySession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([userId, seedKeyword])
  @@index([userId, siteId, seedKeyword])
  @@index([keyword])
  @@index([groupType])
  @@index([platform, location, language])
}

// ─── Historical Keyword Volume Tracking ───────────────────────────────────────

model KeywordSnapshot {
  id          String   @id @default(cuid())
  userId      String
  keyword     String
  platform    String   @default("google")
  location    String
  language    String
  volume      Int?
  desktopVolume Int?   // Desktop search volume at snapshot time
  mobileVolume Int?    // Mobile search volume at snapshot time
  difficulty  Int?
  cpc         Float?
  intent      String?
  snapshotDate DateTime @default(now()) // Date of the snapshot
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, keyword, platform])
  @@index([snapshotDate])
  @@unique([userId, keyword, platform, location, snapshotDate])
}

// ─── Demographic Insights per Keyword ──────────────────────────────────────────

model KeywordDemographic {
  id          String   @id @default(cuid())
  userId      String
  keyword     String
  platform    String
  ageRange    String   // "18-24", "25-34", etc.
  percentage  Float    // % of searches from this age group
  searchCount Int?     // Absolute count if available
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, keyword, platform])
  @@unique([userId, keyword, platform, ageRange])
}

// ─── AI Decision Engine ──────────────────────────────────────────────────────

model DecisionRun {
  id          String   @id @default(cuid())
  userId      String
  siteId      String?
  keyword     String
  domain      String
  location    String   @default("United States")
  language    String   @default("en")
  score       Int?
  priority    String?
  payloadJson String
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  site SiteProject? @relation(fields: [siteId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([userId, siteId, createdAt])
}

model DailyIntelDigest {
  id          String   @id @default(cuid())
  userId      String
  siteId      String?
  topic       String
  payloadJson String
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  site SiteProject? @relation(fields: [siteId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([userId, siteId, createdAt])
}

model IndustryStat {
  id          String   @id @default(cuid())
  industry    String   @default("general")
  metricKey   String
  metricValue Float
  unit        String?
  note        String?
  source      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([industry, metricKey])
  @@index([industry])
}

model KeywordIntelligence {
  id               String   @id @default(cuid())
  keyword          String
  locationCode     Int      @default(2840)
  languageCode     String   @default("en")
  searchVolume     Int?
  cpc              Float?
  competition      Float?
  competitionLevel String?
  difficulty       Int?
  // Click distribution (SERP-signal-based model)
  organicClickPct  Int?
  paidClickPct     Int?
  aiOverviewPct    Int?
  featuredSnippetPct Int?
  noClickPct       Int?
  // SERP features present at analysis time
  hasAiOverview    Boolean  @default(false)
  hasFeaturedSnippet Boolean @default(false)
  hasLocalPack     Boolean  @default(false)
  topAdCount       Int      @default(0)
  hasShopping      Boolean  @default(false)
  // Intelligence metadata
  analyzedCount    Int      @default(1)
  firstAnalyzed    DateTime @default(now())
  lastAnalyzed     DateTime @default(now()) @updatedAt
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, keyword, locationCode, languageCode])
  @@index([userId])
  @@index([keyword])
  @@index([userId, lastAnalyzed])
}

model ApiQueryLog {
  id          String   @id @default(cuid())
  userId      String?
  endpoint    String
  queryKey    String
  durationMs  Int?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([endpoint])
  @@index([createdAt])
}
