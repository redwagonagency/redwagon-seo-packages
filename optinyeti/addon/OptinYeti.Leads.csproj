<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>OptinYeti.Leads</AssemblyName>
    <RootNamespace>OptinYeti.Leads</RootNamespace>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="theme/theme.css" LogicalName="theme.css" />
    <EmbeddedResource Include="theme/tailwind-config.js" LogicalName="tailwind-config.js" />
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <Reference Include="Microsoft.Data.Sqlite">
      <HintPath>lib/Microsoft.Data.Sqlite.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SQLitePCLRaw.core">
      <HintPath>lib/SQLitePCLRaw.core.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
